generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SchoolLevel {
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  MIXED
}

enum BuzzerRoomStatus {
  WAITING
  READING
  RUNNING
  BUZZED
  BONUS
  PAUSED
  TIMEOUT
  ENDED
}

enum BuzzerRoomEventType {
  ROOM_CREATED
  SEAT_TAKEN
  SEAT_LEFT
  ROUND_STARTED
  DONE_READING
  TIMER_PAUSED
  TIMER_RESUMED
  BUZZED
  BUZZED_DURING_READING
  INTERRUPT_CONFIRMED
  INTERRUPT_INCORRECT
  QUESTION_DEAD
  ROUND_CLOCK_EXPIRED
  CORRECT
  INCORRECT
  BONUS_QUEUED
  NEXT_QUESTION
  RESET
  GAME_ENDED
}

model BuzzerRoom {
  id                      String            @id
  code                    String            @unique
  organizerPassword       String
  status                  BuzzerRoomStatus  @default(WAITING)
  version                 Int               @default(0)
  schoolLevel             SchoolLevel?
  teamAName               String            @default("Team A")
  teamBName               String            @default("Team B")
  teamAScore              Int               @default(0)
  teamBScore              Int               @default(0)
  timerStartedAt          DateTime?
  timerDurationMs         Int               @default(15000)
  timerElapsedMs          Int               @default(0)
  questionClockStartedAt  DateTime?
  questionClockDurationMs Int               @default(0)
  questionClockElapsedMs  Int               @default(0)
  buzzedIsInterrupt       Boolean           @default(false)
  totalRounds             Int               @default(3)
  roundNumber             Int               @default(1)
  questionNumber          Int               @default(1)
  currentQuestionId       String?
  buzzedSeatId            String?           @unique
  buzzedSeat              BuzzerSeat?       @relation("BuzzedSeat", fields: [buzzedSeatId], references: [id], onDelete: SetNull)
  expiresAt               DateTime
  seats                   BuzzerSeat[]      @relation("RoomSeats")
  events                  BuzzerRoomEvent[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([code])
  @@index([expiresAt])
  @@index([status])
}

model BuzzerSeat {
  id              String      @id
  roomId          String
  room            BuzzerRoom  @relation("RoomSeats", fields: [roomId], references: [id], onDelete: Cascade)
  buzzedIn        BuzzerRoom? @relation("BuzzedSeat")
  team            String
  slot            String
  participantName String?
  buzzedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([roomId, team, slot])
  @@index([roomId])
}

model BuzzerRoomEvent {
  id        String              @id
  roomId    String
  room      BuzzerRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type      BuzzerRoomEventType
  message   String
  createdAt DateTime            @default(now())

  @@index([roomId, createdAt])
}

enum UserRole {
  STUDENT
  PARENT
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(STUDENT) // (ours)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@index([email])
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt]) // (ours) enables cheap expired-session cleanup
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String // provider-side id; equals userId for credentials
  providerId            String // "credential" for email+password; "google" etc. later
  password              String? // scrypt hash; only for providerId = "credential"
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String // e.g. email or token scope key
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt]) // (ours) cleanup
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([key])
}
