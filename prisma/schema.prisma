generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  FOUNDATIONAL
  INTERMEDIATE
  ADVANCED
}

enum QuestionFormat {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum QuestionKind {
  PRACTICE
  TOSSUP
  BONUS
  REVIEW
}

enum SchoolLevel {
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  MIXED
}

enum ClassificationDifficulty {
  EASY
  MEDIUM
  HARD
}

model Competition {
  id               String             @id
  slug             String             @unique
  name             String
  description      String
  shortDescription String
  subdomain        String             @unique
  categories       String[]
  concepts         Concept[]
  curriculumSubjects CurriculumSubject[]
  levels           CompetitionLevel[]
  questions        Question[]
  lessons          Lesson[]
  tests            Test[]
  buzzerQuestions  BuzzerQuestion[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model CompetitionLevel {
  id            String       @id
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  description   String?
  schoolLevel   SchoolLevel?
  sortOrder     Int          @default(0)
  curriculumSubjects CurriculumSubject[]
  questions     Question[]
  lessons       Lesson[]
  tests         Test[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([competitionId, slug])
  @@index([competitionId])
}

model Question {
  id               String         @id
  competitionId    String
  competition      Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  levelId          String?
  competitionLevel CompetitionLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  category         String
  level            String
  difficulty       Difficulty
  format           QuestionFormat
  questionKind     QuestionKind   @default(PRACTICE)
  schoolLevel      SchoolLevel?
  sourceProvider   String?
  sourcePageUrl    String?
  sourcePdfUrl     String?
  sourceSet        String?
  sourceRound      String?
  sourceQuestionNumber Int?
  sourceHash       String?        @unique
  prompt           String
  choices          Json?
  correctAnswer    String
  alternateAnswers String[]
  explanation      String
  answers          Answer[]
  answerExplanations AnswerExplanation[]
  concepts         QuestionConcept[]
  curriculumTopics  CurriculumTopicQuestion[]
  topicClassification QuestionTopicClassification?
  tests            TestQuestion[]
  buzzerRooms      BuzzerRoom[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([competitionId])
  @@index([levelId])
  @@index([competitionId, category, difficulty, format])
  @@index([competitionId, schoolLevel])
  @@index([sourceProvider, sourceSet])
}

model Concept {
  id               String            @id
  competitionId    String
  competition      Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  category         String
  schoolLevel      SchoolLevel?
  shortDescription String
  aliases          String[]
  lessons          Lesson[]
  questions        QuestionConcept[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([competitionId, slug, category, schoolLevel])
  @@index([competitionId])
  @@index([competitionId, category, schoolLevel])
}

model QuestionConcept {
  questionId String
  conceptId  String
  isPrimary  Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@index([conceptId])
  @@index([questionId, isPrimary])
}

model AnswerExplanation {
  id                  String   @id
  questionId          String
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  shortExplanation    String
  detailedExplanation String?
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([questionId, position])
  @@index([questionId])
}

model Answer {
  id          String           @id
  questionId  String
  question    Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean          @default(false)
  explanation String?
  position    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([questionId, text])
  @@unique([questionId, position])
  @@index([questionId])
}

model QuestionTopicClassification {
  id            String                    @id
  questionId    String                    @unique
  question      Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic         String
  subtopic      String
  keyConcept    String
  difficulty    ClassificationDifficulty
  confidence    Float
  needsReview   Boolean                   @default(false)
  model         String?
  promptVersion String?
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([topic])
  @@index([subtopic])
  @@index([confidence])
  @@index([needsReview])
}

model Lesson {
  id               String      @id
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  levelId          String?
  competitionLevel CompetitionLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  conceptId        String?
  concept          Concept?    @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  slug             String
  title            String
  category         String
  level            String
  estimatedMinutes Int
  summary          String
  keyConcepts      String[]
  contentSections  Json
  reviewQuestions  String[]
  curriculumTopics CurriculumTopicLesson[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([competitionId, slug])
  @@index([competitionId])
  @@index([levelId])
  @@index([conceptId])
}

model Test {
  id               String         @id
  competitionId    String
  competition      Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  levelId          String?
  competitionLevel CompetitionLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  slug             String
  title            String
  level            String
  categories       String[]
  timeLimitMinutes Int
  description      String
  questions        TestQuestion[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([competitionId, slug])
  @@index([competitionId])
  @@index([levelId])
}

model TestQuestion {
  testId     String
  questionId String
  position   Int
  test       Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@unique([testId, position])
}

model BuzzerQuestion {
  id                String      @id
  competitionId     String
  competition       Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  category          String
  difficulty        Difficulty
  tossupPrompt      String
  tossupAnswer      String
  tossupExplanation String
  bonusPrompt       String
  bonusAnswer       String
  bonusExplanation  String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([competitionId])
}

model CurriculumSubject {
  id               String            @id
  competitionId    String
  competition      Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  levelId          String?
  competitionLevel CompetitionLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  slug             String
  name             String
  shortDescription String
  whyItMatters     String
  highYieldTopics  String[]
  sources          String[]
  sortOrder        Int               @default(0)
  grades           CurriculumGrade[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([competitionId, levelId, slug])
  @@index([competitionId])
  @@index([levelId])
}

model CurriculumGrade {
  id          String           @id
  subjectId   String
  subject     CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  key         String
  label       String
  sortOrder   Int              @default(0)
  units       CurriculumUnit[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([subjectId, key])
  @@index([subjectId])
}

model CurriculumUnit {
  id         String           @id
  gradeId    String
  grade      CurriculumGrade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  title      String
  sortOrder  Int              @default(0)
  topics     CurriculumTopic[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([gradeId, title])
  @@index([gradeId])
}

model CurriculumTopic {
  id         String                  @id
  unitId     String
  unit       CurriculumUnit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  sortOrder  Int                     @default(0)
  lessons    CurriculumTopicLesson[]
  questions  CurriculumTopicQuestion[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([unitId, title])
  @@index([unitId])
}

model CurriculumTopicLesson {
  topicId    String
  lessonId   String
  position   Int         @default(0)
  topic      CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([topicId, lessonId])
  @@index([lessonId])
  @@unique([topicId, position])
}

model CurriculumTopicQuestion {
  topicId    String
  questionId String
  position   Int         @default(0)
  topic      CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([topicId, questionId])
  @@index([questionId])
  @@unique([topicId, position])
}

model BuzzerRoom {
  id                  String            @id
  code                String            @unique
  organizerPassword   String
  status              String            @default("WAITING")
  teamAName           String            @default("Team A")
  teamBName           String            @default("Team B")
  teamAScore          Int               @default(0)
  teamBScore          Int               @default(0)
  timerStartedAt      DateTime?
  timerDurationMs     Int               @default(15000)
  timerElapsedMs      Int               @default(0)
  questionClockStartedAt DateTime?
  questionClockDurationMs Int            @default(0)
  questionClockElapsedMs Int             @default(0)
  buzzedIsInterrupt   Boolean           @default(false)
  totalRounds         Int               @default(3)
  roundNumber         Int               @default(1)
  questionNumber      Int               @default(1)
  currentQuestionId   String?
  currentQuestion     Question?          @relation(fields: [currentQuestionId], references: [id], onDelete: SetNull)
  buzzedSeatId        String?
  expiresAt           DateTime
  seats               BuzzerSeat[]
  events              BuzzerRoomEvent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([code])
  @@index([expiresAt])
  @@index([currentQuestionId])
}

model BuzzerSeat {
  id              String      @id
  roomId          String
  room            BuzzerRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  team            String
  slot            String
  participantName String?
  buzzedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([roomId, team, slot])
  @@index([roomId])
}

model BuzzerRoomEvent {
  id        String      @id
  roomId    String
  room      BuzzerRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime    @default(now())

  @@index([roomId, createdAt])
}
