# PostgreSQL connection string — required for the Buzzer Arena only.
# Content (questions, lessons) is served from committed JSON/Markdown files; no DB needed for that.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Vercel/Supabase integrations often provide these names instead of DATABASE_URL.
# src/lib/db.ts tries them in order: DATABASE_URL → POSTGRES_PRISMA_URL → POSTGRES_URL → POSTGRES_URL_NON_POOLING
# → assembled from POSTGRES_HOST/USER/PASSWORD/DATABASE.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Assembled from parts if none of the above are set.
# POSTGRES_HOST="HOST"
# POSTGRES_USER="USER"
# POSTGRES_PASSWORD="PASSWORD"
# POSTGRES_DATABASE="DATABASE"

# Canonical site URL for SEO / Open Graph (src/lib/seo.ts).
# Defaults to https://medalminds.vercel.app if unset.
NEXT_PUBLIC_SITE_URL="https://medalminds.com"

# Required by: npm run generate:nsb-answer-explanations
# Backfills the explainAnswer field in content/nsb/json/questions.json via OpenAI.
# Do not expose this as a NEXT_PUBLIC_* variable.
OPENAI_API_KEY="sk-..."

# Optional overrides for the generate:nsb-answer-explanations script.
# OPENAI_MODEL="gpt-4o-mini"      # default: gpt-4o-mini
# OPENAI_RPM="300"                 # requests per minute, default 300
# OPENAI_CONCURRENCY="10"          # parallel workers, default 10

# Authentication (Better Auth). Requires DATABASE_URL above to be set.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-bytes"
# Canonical origin used for auth callbacks/CSRF trusted-origin checks.
# Falls back to NEXT_PUBLIC_SITE_URL if unset.
BETTER_AUTH_URL="https://medalminds.com"

# Optional — transactional email (verification, password reset, notices).
# When unset, emails are logged to the console instead of sent (dev/test safe).
RESEND_API_KEY="re_..."
EMAIL_FROM="MedalMinds <no-reply@medalminds.com>"
