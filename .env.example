DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional for hosted providers that separate pooled runtime connections
# from direct migration connections.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Vercel/Supabase integrations often provide these names instead.
# Runtime reads use POSTGRES_PRISMA_URL or POSTGRES_URL when DATABASE_URL is absent.
# Prisma migrations prefer POSTGRES_URL_NON_POOLING or DIRECT_URL.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional admin-only script for generating worked answer explanations.
# Do not expose this as a NEXT_PUBLIC_* variable.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Shared secret for POST /api/revalidate, used by admin content scripts to
# purge cached reads after a --write run (?secret=...&tag=content:<slug>).
REVALIDATE_SECRET="change-me"

# Free Groq API key, used by POST /api/ai/explain to generate on-demand
# "how to solve this" tutoring explanations for practice questions.
# Get one at https://console.groq.com/keys — no billing required.
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"
